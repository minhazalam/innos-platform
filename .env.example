# Use letters and numbers only for the MongoDB credentials because they are
# interpolated into MONGO_URL below.
MONGO_ROOT_USERNAME=innosroot
MONGO_ROOT_PASSWORD=replace-with-a-random-hex-secret
JWT_SECRET=replace-with-a-different-random-hex-secret

# The browser origin shown in the address bar, with no trailing slash.
FRONTEND_URL=http://localhost:3000
WEB_PORT=3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SEED_DEMO=false

# Owner used when SEED_DEMO=true. Change before enabling sample data.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=Owner@123

# Optional OpenAI-compatible provider. Leave blank for the local deterministic fallback.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
